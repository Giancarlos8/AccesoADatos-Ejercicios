package com.mycompany.gestorcuentas;

import java.io.*;
import java.util.ArrayList;
import java.util.Scanner;

public class GestorCuentas {

    private static final String NOMBRE_FICHERO = "cuentas.dat";

    public static void main(String[] args) {
        comprobarEInicializarFichero();

        Scanner scanner = new Scanner(System.in);
        int opcion = 0;

        do {
            System.out.println("\n<GESTOR DE CUENTA CORRIENTE>");
            System.out.println("1. Listar apuntes");
            System.out.println("2. Añadir apunte");
            System.out.println("3. Eliminar apunte por ID");
            System.out.println("4. Modificar concepto por ID");
            System.out.println("5. Ver número de registros y tamaño");
            System.out.println("6. Probar cierre y reapertura");
            System.out.println("7. Salir");
            System.out.print("Elige una opción: ");

            try {
                opcion = Integer.parseInt(scanner.nextLine());

                switch (opcion) {
                    case 1: listarApuntes(); break;
                    case 2: añadirApunte(scanner); break;
                    case 3: eliminarApunte(scanner); break;
                    case 4: modificarApunte(scanner); break;
                    case 5: mostrarInfoFichero(); break;
                    case 6: probarCierreYReapertura(); break;
                    case 7: System.out.println("Saliendo..."); break;
                    default: System.out.println("Opción no válida.");
                }
            } catch (Exception e) {
                System.out.println("Error: Introduce un número.");
            }

        } while (opcion != 7);

        scanner.close();
    }

    public static void comprobarEInicializarFichero() {
        File fichero = new File(NOMBRE_FICHERO);
        if (fichero.exists()) return;

        ArrayList<ApunteBancario> listaInicial = new ArrayList<>();
        listaInicial.add(new ApunteBancario(1, "01-01", "Saldo anterior", "-", 3528.76, 3528.76));
        listaInicial.add(new ApunteBancario(2, "05-01", "Pago fra. teléfono", "05-01", -91.57, 3437.19));
        listaInicial.add(new ApunteBancario(3, "10-01", "Ingreso en efectivo", "10-01", 150.00, 3587.19));
        listaInicial.add(new ApunteBancario(4, "20-01", "Cargo compra", "20-01", -123.45, 3071.13));
        listaInicial.add(new ApunteBancario(5, "15-01", "Pago de préstamo", "15-01", -392.61, 3194.58));
        listaInicial.add(new ApunteBancario(6, "25-01", "Transf. a su favor", "25-01", 721.27, 3792.40));
        listaInicial.add(new ApunteBancario(7, "31-01", "Reintegro cajero autom.", "31-01", -80.00, 3712.40));

        try (ObjectOutputStream oos = new ObjectOutputStream(new FileOutputStream(fichero))) {
            for (ApunteBancario a : listaInicial) {
                oos.writeObject(a);
            }
            System.out.println("Fichero creado e inicializado.");
        } catch (IOException e) {
                
            System.out.println("Error: " + e.getMessage());
        }
    }

    public static void listarApuntes() {
        System.out.println("\n<LISTADO>");
        File fichero = new File(NOMBRE_FICHERO);
        if (!fichero.exists() || fichero.length() == 0) {
            System.out.println("No hay datos.");
            return;
        }

        try (ObjectInputStream ois = new ObjectInputStream(new FileInputStream(fichero))) {
            while (true) {
                try {
                    ApunteBancario a = (ApunteBancario) ois.readObject();
                    System.out.println(a);
                } catch (EOFException e) {
                    break;
                }
            }
        } catch (Exception e) {
            System.out.println("Error al leer: " + e.getMessage());
        }
    }

    public static void añadirApunte(Scanner scanner) {
        System.out.println("\n<AÑADIR>");
        try {
            System.out.print("ID: ");
            int id = Integer.parseInt(scanner.nextLine());
            System.out.print("Fecha: ");
            String fecha = scanner.nextLine();
            System.out.print("Concepto: ");
            String concepto = scanner.nextLine();
            System.out.print("Valor: ");
            String valor = scanner.nextLine();
            System.out.print("Importe: ");
            double importe = Double.parseDouble(scanner.nextLine());
            System.out.print("Saldo: ");
            double saldo = Double.parseDouble(scanner.nextLine());

            ArrayList<ApunteBancario> lista = cargarListaDesdeFichero();
            lista.add(new ApunteBancario(id, fecha, concepto, valor, importe, saldo));
            guardarListaEnFichero(lista);

            System.out.println("Añadido");
        } catch (Exception e) {
            System.out.println("Error en los datos.");
        }
    }

    public static void eliminarApunte(Scanner scanner) {
        System.out.println("\n<ELIMINAR>");
        try {
            System.out.print("Introduce ID a eliminar: ");
            int idBuscar = Integer.parseInt(scanner.nextLine());

            ArrayList<ApunteBancario> lista = cargarListaDesdeFichero();
            boolean borrado = false;

            for (int i = 0; i < lista.size(); i++) {
                if (lista.get(i).getId() == idBuscar) {
                    lista.remove(i);
                    borrado = true;
                    break;
                }
            }

            if (borrado) {
                guardarListaEnFichero(lista);
                System.out.println("Eliminado");
            } else {
                System.out.println("ID no encontrado.");
            }
        } catch (Exception e) {
            System.out.println("Error: " + e.getMessage());
        }
    }

    public static void modificarApunte(Scanner scanner) {
        System.out.println("\n<MODIFICAR>");
        try {
            System.out.print("Introduce ID a modificar: ");
            int idBuscar = Integer.parseInt(scanner.nextLine());
            System.out.print("Nuevo concepto: ");
            String nuevoConcepto = scanner.nextLine();

            ArrayList<ApunteBancario> lista = cargarListaDesdeFichero();
            boolean modificado = false;

            for (ApunteBancario a : lista) {
                if (a.getId() == idBuscar) {
                    a.setConcepto(nuevoConcepto);
                    modificado = true;
                }
            }

            if (modificado) {
                guardarListaEnFichero(lista);
                System.out.println("Modificado");
            } else {
                System.out.println("ID no encontrado.");
            }
        } catch (Exception e) {
            System.out.println("Error: " + e.getMessage());
        }
    }

    public static void mostrarInfoFichero() {
        System.out.println("\n<INFO FICHERO>");
        File fichero = new File(NOMBRE_FICHERO);
        if (!fichero.exists()) {
            System.out.println("No existe.");
            return;
        }

        ArrayList<ApunteBancario> lista = cargarListaDesdeFichero();
        System.out.println("Registros: " + lista.size());
        System.out.println("Tamaño: " + fichero.length() + " bytes");
    }

    public static void probarCierreYReapertura() {
        System.out.println("\n<REABRIENDO FICHERO>");
        listarApuntes();
        mostrarInfoFichero();
    }

    private static ArrayList<ApunteBancario> cargarListaDesdeFichero() {
        ArrayList<ApunteBancario> lista = new ArrayList<>();
        File fichero = new File(NOMBRE_FICHERO);
        if (!fichero.exists()) return lista;

        try (ObjectInputStream ois = new ObjectInputStream(new FileInputStream(fichero))) {
            while (true) {
                try {
                    ApunteBancario a = (ApunteBancario) ois.readObject();
                    lista.add(a);
                } catch (EOFException e) {
                    break;
                }
            }
        } catch (Exception e) {
            System.out.println("Error: " + e.getMessage());
        }
        return lista;
    }

    private static void guardarListaEnFichero(ArrayList<ApunteBancario> lista) {
        try (ObjectOutputStream oos = new ObjectOutputStream(new FileOutputStream(NOMBRE_FICHERO))) {
            for (ApunteBancario a : lista) {
                oos.writeObject(a);
            }
        } catch (IOException e) {
            System.out.println("Error: " + e.getMessage());
        }
    }
}
